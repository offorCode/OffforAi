void MainComponent::resized()
{
    auto area =
        getLocalBounds().reduced(24);

    // ======================================================
    // HEADER
    // ======================================================

    auto header =
        area.removeFromTop(46);

    // Logo
    auto logoArea =
        header
            .removeFromLeft(42)
            .reduced(8);

    juce::ignoreUnused(
        logoArea
    );

    // Export button
    auto exportButtonArea =
        header
            .removeFromRight(120)
            .reduced(4, 5);

    exportSectionButton.setBounds(
        exportButtonArea
    );

    // Header title
    headerTitleLabel.setBounds(
        header.reduced(12, 0)
    );

    // ======================================================
    // SPACE
    // ======================================================

    area.removeFromTop(12);

    // ======================================================
